rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /license-documents/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024;
    }
  }
}
