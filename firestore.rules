rules_version = '2';
// Starting-point rules — good enough to keep the app usable while wiring up
// Firebase, NOT a finished security model. Known gaps to close before real
// production use:
//   - A nurse's own write access to /nurses/{uid} currently covers the whole
//     doc, so nothing stops them from setting their own `verification` field
//     to "verified" via a raw Firestore write (bypassing the app's UI).
//   - Facility ratings (`rating`, `shiftsCompleted`) are written by a
//     facility-authenticated session, which this file doesn't model as a
//     distinct role yet — tighten by adding field-level checks once ratings
//     go live, or move both verification and rating writes into a Cloud
//     Function that runs with admin privileges instead of client writes.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Nurses can read/write their own profile. Admins can also update a
    // nurse's doc (this is how the admin review screen flips
    // verification to "verified"/"rejected") — the client itself never
    // grants a nurse permission to verify their own license.
    match /nurses/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // A facility can create/update its own doc (uid == facilityId, from
    // sign-up). Admins can also create/update any facility doc — this is
    // what the admin single-add form and CSV bulk import rely on, since
    // those facilities have no matching auth account at all.
    match /facilities/{facilityId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == facilityId || isAdmin());
    }

    // Any signed-in nurse can read open shifts; only the owning facility
    // should be able to create/update its own shifts in a hardened setup.
    match /shifts/{shiftId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    match /shiftClaims/{claimId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // Presence of a doc here grants admin access in the app's client code.
    // Only create these by hand (Console) or via a trusted backend —
    // never allow client writes to this collection.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Chat: only the two participants of a conversation can read/write it
    // or its messages. participantIds is set once at creation and never
    // changes, so this also stops someone from adding themselves later.
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // Calling (WebRTC signaling): only the caller/callee can read or update
    // a call doc. ICE candidate subcollections are left open to any signed-in
    // user rather than re-checking caller/callee on every candidate write,
    // since call IDs aren't guessable and candidates alone reveal only
    // network routing info, not app data.
    match /calls/{callId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.callerId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      match /callerCandidates/{candidateId} {
        allow read, create: if request.auth != null;
      }
      match /calleeCandidates/{candidateId} {
        allow read, create: if request.auth != null;
      }
    }
  }
}
